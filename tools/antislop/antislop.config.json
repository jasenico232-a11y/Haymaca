{
  "$comment": "NSE Anti-Generic Standard. Tune weights per project; do not delete rules.",
  "failScore": 60,
  "copy": {
    "bannedPhrases": [
      "seamless","seamlessly","elevate your","unlock the","unlock your","transform your",
      "take it to the next level","journey begins","at the heart of","we believe that",
      "in today's fast-paced","cutting-edge","state-of-the-art","game-changer","game changer",
      "revolutionize","revolutionise","empower your","supercharge","best-in-class",
      "one-stop shop","tailored solutions","bespoke solutions","holistic approach",
      "seamless experience","seamless integration","dive in","let's dive","embark on",
      "seamless journey","curated selection","seamless transition","seamless process",
      "seamlessly integrate","unparalleled","world-class","seamless flow"
    ],
    "hedgeWords": ["innovative","dynamic","robust","leverage","synergy","seamless","holistic","bespoke"],
    "placeholders": ["lorem ipsum","dolor sit amet","TODO","FIXME","PLACEHOLDER","Your Company","Company Name","John Doe","Jane Doe","example@example.com","+1 234 567","123 Main St"]
  },
  "visual": {
    "bannedClassPatterns": [
      {"id":"purple-blue-gradient","re":"from-(purple|violet|indigo)-\\d+[^\"']*to-(blue|cyan|sky)-\\d+","why":"The single most recognisable AI-generated palette."},
      {"id":"gradient-text","re":"bg-clip-text[^\"']*text-transparent","why":"Gradient headline text is a template signature."},
      {"id":"glassmorphism","re":"backdrop-blur[^\"']*bg-(white|black)/(10|20|30)","why":"Frosted glass cards read as generated."},
      {"id":"generic-blob","re":"(blur-3xl|blur-2xl)[^\"']*(rounded-full)","why":"Abstract background blobs are pure filler."}
    ],
    "rawTailwindColors": "\\b(bg|text|border|from|to|via)-(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-(50|100|200|300|400|500|600|700|800|900|950)\\b",
    "radiusClasses": "\\brounded-(sm|md|lg|xl|2xl|3xl|full)\\b",
    "shadowClasses": "\\bshadow-(sm|md|lg|xl|2xl)\\b",
    "emojiInJsx": "[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]"
  },
  "layout": {
    "centeredHero": {"needs":["text-center","justify-center"],"why":"Centred hero with a headline and two buttons is the clearest tell."},
    "threeColGrid":"grid-cols-3",
    "maxRepeatedShadow": 8,
    "maxRepeatedRadius": 12
  },
  "structure": {
    "requireTokenLayer": true,
    "requireFontConfig": true,
    "minTypeScaleRatio": 3.0,
    "requireAltText": true
  }
}
